target/
!.mvn/wrapper/maven-wrapper.jar
*.iml
.idea/
build/
.DS_Store
# Anchored, and it must stay anchored: this is the runtime data directory a local run writes at
# the repo root. Unanchored, `data/` matches a directory of that name ANYWHERE, which silently
# excluded a whole Java package (`org.alexmond.kweblens.tui.data`) from `git add` — the files
# compiled locally and would simply not have been in the commit.
/data/
*.log

# kweblens-ui (Vite/React): build output + toolchain downloaded by frontend-maven-plugin
kweblens-ui/node_modules/
kweblens-ui/dist/
kweblens-ui/.node/
kweblens-ui/node/
kweblens-ui/coverage/

# Local kubeconfigs must never be committed
*.kubeconfig
kubeconfig
.kube/

# Claude Code personal per-project settings
.claude/settings.local.json

# dev-crew transient run handoffs
.claude/dev-crew/runs/

# prompt-coach local mastery state (per-machine, not shared)
.claude/prompt-coach/

# Screenshot-tour output lands in the module dir (surefire CWD); the deck lives in /presentation
kweblens-web/presentation/

# Playwright captures: these are pictures of a live cluster and contain its API
# server hostname, node names and namespaces. Never commit one.
.playwright/

# Throwaway git worktrees for parallel agent runs. Ephemeral by construction — each is a
# checkout that is removed when its run ends — so committing one would commit a copy of the
# repo inside itself.
.claude/worktrees/
