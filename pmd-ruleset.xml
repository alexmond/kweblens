<?xml version="1.0"?>
<ruleset name="kweblens PMD Rules"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>PMD ruleset for the kweblens project</description>

    <!-- Best Practices -->
    <rule ref="category/java/bestpractices.xml">
        <exclude name="UnitTestContainsTooManyAsserts"/>
        <exclude name="UnitTestAssertionsShouldIncludeMessage"/>
        <exclude name="LooseCoupling"/>
        <exclude name="UseVarargs"/>
        <exclude name="LiteralsFirstInComparisons"/>
        <exclude name="UnusedAssignment"/>
        <exclude name="GuardLogStatement"/>
        <!-- `JUnitTestsShouldIncludeAssert` was excluded here and NEVER TOOK EFFECT: PMD 7 keeps
             it only as `deprecated="true" ref="UnitTestShouldIncludeAssert"`, and exclude patterns
             do not resolve deprecated aliases, so PMD warned on every module build. Deleted rather
             than renamed, because the rule it aliases cannot fire either — the plugin runs with
             `includeTests=false`, so no test source is ever analysed. Suppressing a rule that
             cannot reach any file is policy-shaped noise. If test analysis is ever turned on,
             decide then whether the rule is wanted. -->
    </rule>

    <!-- Code Style -->
    <rule ref="category/java/codestyle.xml">
        <exclude name="AtLeastOneConstructor"/>
        <exclude name="OnlyOneReturn"/>
        <exclude name="LocalVariableCouldBeFinal"/>
        <exclude name="MethodArgumentCouldBeFinal"/>
        <exclude name="ShortVariable"/>
        <exclude name="LongVariable"/>
        <exclude name="ShortMethodName"/>
        <exclude name="ShortClassName"/>
        <exclude name="CommentDefaultAccessModifier"/>
        <exclude name="CallSuperInConstructor"/>
        <exclude name="ConfusingTernary"/>
        <exclude name="TooManyStaticImports"/>
        <exclude name="UseExplicitTypes"/>
        <exclude name="UselessParentheses"/>
        <exclude name="FieldDeclarationsShouldBeAtStartOfClass"/>
        <exclude name="FieldNamingConventions"/>
        <!-- `OneDeclarationPerLine` was excluded here and NEVER TOOK EFFECT: the rule lives in
             `bestpractices`, not `codestyle`, so PMD warned that the pattern matched nothing while
             the rule stayed ON through the bestpractices reference above. Deleted rather than moved
             to the right block, because the code has satisfied it all along — moving it would
             switch OFF a rule that has been passing, which is a loosening disguised as a warning
             fix. Re-add it to the bestpractices block only if it starts costing something real. -->
        <exclude name="LinguisticNaming"/>
        <!-- Conflicts with Checkstyle's SpringLambda (which wants parenthesised lambda args) on
             idiomatic Spring Security DSL customizers like frame -> frame.sameOrigin(). -->
        <exclude name="LambdaCanBeMethodReference"/>
    </rule>
    <rule ref="category/java/codestyle.xml/ClassNamingConventions">
        <properties>
            <property name="utilityClassPattern" value="[A-Z][a-zA-Z0-9]*"/>
        </properties>
    </rule>

    <!-- Design -->
    <rule ref="category/java/design.xml">
        <exclude name="ImmutableField"/>
        <exclude name="LawOfDemeter"/>
        <exclude name="LoosePackageCoupling"/>
        <exclude name="DataClass"/>
        <exclude name="TooManyMethods"/>
        <exclude name="ExcessiveImports"/>
        <exclude name="CouplingBetweenObjects"/>
        <exclude name="AvoidCatchingGenericException"/>
        <exclude name="ExcessiveParameterList"/>
        <exclude name="CyclomaticComplexity"/>
        <exclude name="NcssCount"/>
        <exclude name="NPathComplexity"/>
        <exclude name="GodClass"/>
        <exclude name="TooManyFields"/>
        <exclude name="AvoidThrowingRawExceptionTypes"/>
        <exclude name="SignatureDeclareThrowsException"/>
        <exclude name="UseObjectForClearerAPI"/>
        <exclude name="CognitiveComplexity"/>
        <exclude name="SimplifyBooleanReturns"/>
        <exclude name="AvoidDeeplyNestedIfStmts"/>
        <exclude name="CollapsibleIfStatements"/>
        <!-- Spring Boot @SpringBootApplication main class has only a static main() -->
        <exclude name="UseUtilityClass"/>
        <!-- `MissingStaticMethodInNonInstantiatableClass` was excluded here and NEVER TOOK EFFECT:
             the rule lives in `errorprone`, not `design`, so PMD warned that the pattern matched
             nothing while the rule stayed ON through the errorprone reference below. Its stated
             reason — "DTO holder classes group nested records behind a private constructor" —
             evidently never applied, since the build has been green with the rule active. Deleted
             rather than moved, for the same reason as `OneDeclarationPerLine` above: moving it
             would switch off a passing rule. -->
    </rule>

    <!-- Error Prone -->
    <rule ref="category/java/errorprone.xml">
        <exclude name="NonSerializableClass"/>
        <exclude name="AvoidLiteralsInIfCondition"/>
        <exclude name="AvoidDuplicateLiterals"/>
        <exclude name="MissingSerialVersionUID"/>
        <exclude name="AvoidFieldNameMatchingMethodName"/>
        <exclude name="AvoidFieldNameMatchingTypeName"/>
        <exclude name="NullAssignment"/>
        <exclude name="ReturnEmptyCollectionRatherThanNull"/>
        <exclude name="AssignmentInOperand"/>
        <exclude name="TestClassWithoutTestCases"/>
        <exclude name="ReplaceJavaUtilDate"/>
        <!-- Borrowed KubernetesClients are owned by the ClusterRegistry, never by the caller —
             services/controllers must NOT close a client they got from require()/client(). -->
        <exclude name="CloseResource"/>
    </rule>

    <!-- Multithreading -->
    <rule ref="category/java/multithreading.xml">
        <exclude name="UseConcurrentHashMap"/>
        <exclude name="DoNotUseThreads"/>
    </rule>

    <!-- Performance -->
    <rule ref="category/java/performance.xml">
        <exclude name="AvoidInstantiatingObjectsInLoops"/>
        <exclude name="ConsecutiveAppendsShouldReuse"/>
        <exclude name="InsufficientStringBufferDeclaration"/>
    </rule>

</ruleset>
