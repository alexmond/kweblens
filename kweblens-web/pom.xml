<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.alexmond</groupId>
        <artifactId>kweblens-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>kweblens-web</artifactId>
    <name>kweblens-web</name>
    <description>kweblens Spring Boot application — REST API and Thymeleaf/htmx Kubernetes dashboard</description>

    <!-- The self-hosted server -> AGPL-3.0 (overrides the parent's Apache; see root LICENSE).
         Not published to Maven Central. -->
    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0 only</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <dependencies>
        <dependency>
            <groupId>org.alexmond</groupId>
            <artifactId>kweblens-core</artifactId>
        </dependency>

        <!-- The React SPA, packaged as classpath static resources under static/ui (served at /ui). -->
        <dependency>
            <groupId>org.alexmond</groupId>
            <artifactId>kweblens-ui</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Helm releases via the sibling jhelm library (dogfood). jhelm-kube brings jhelm-core +
             the official io.kubernetes client; jhelm's own auto-configuration is excluded (see
             application.yml) so we use it purely as a library, one KubeService per cluster. -->
        <dependency>
            <groupId>org.alexmond</groupId>
            <artifactId>jhelm-kube</artifactId>
            <version>${jhelm.version}</version>
        </dependency>
        <!-- jhelm's own REST layer (dogfood). We re-enable JhelmCoreAutoConfiguration but keep
             JhelmKubeAutoConfiguration excluded, so only the CLUSTER-AGNOSTIC jhelm beans exist
             (RepoManager, ChartLoader, Show/Template/Create/SearchHub actions). jhelm-rest's
             controllers are individually @ConditionalOnBean: Repo/Chart/Hub/Dependency register
             (repos, chart versions/values, Artifact Hub), while its single-cluster ReleaseController
             stays dormant (no KubeService bean → no ListAction/InstallAction). Multi-cluster release
             ops stay on kweblens's own per-cluster HelmService. -->
        <dependency>
            <groupId>org.alexmond</groupId>
            <artifactId>jhelm-rest-starter</artifactId>
            <version>${jhelm.version}</version>
        </dependency>
        <!-- Credential providers (client-cert / token) to authenticate Helm's official ApiClient
             the same way the cluster's kubeconfig does — jhelm-kube only pulls client-java-api. The
             io.kubernetes.client.util.credentials.* classes live in the main client-java artifact. -->
        <dependency>
            <groupId>io.kubernetes</groupId>
            <artifactId>client-java</artifactId>
            <version>${kubernetes-client.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- WebSocket: bridges an in-browser terminal to a pod exec session (#6). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- Spring Cloud Config client: OPTIONAL import (import-check disabled in application.yml),
             so dev/test and any deploy without a config server boot with the client inert. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>

        <!-- MCP server (SSE over WebMVC) — exposes read-only cluster @Tool methods to AI assistants. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>
        <!-- In-app AI diagnosis (#10): a ChatClient over Anthropic, off unless kweblens.ai.enabled
             and an API key are set. Deterministic validators run with or without it. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-anthropic</artifactId>
        </dependency>

        <!-- Prometheus exporter: the only registry backend we add; Actuator brings
             micrometer-core + the Observation API. Exposes /actuator/prometheus. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Front-end assets served in-jar via WebJars (no CDN for the self-hosted app). -->
        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>bootstrap</artifactId>
            <version>${bootstrap.version}</version>
        </dependency>
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>htmx.org</artifactId>
            <version>${htmx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>bootstrap-icons</artifactId>
            <version>${bootstrap-icons.version}</version>
        </dependency>
        <!-- xterm.js terminal emulator for the in-browser pod exec (served in-jar). -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>xterm</artifactId>
            <version>${xterm.version}</version>
        </dependency>
        <!-- One base layout (head/topbar/footer) for every page. -->
        <dependency>
            <groupId>nz.net.ultraq.thymeleaf</groupId>
            <artifactId>thymeleaf-layout-dialect</artifactId>
            <version>${thymeleaf-layout-dialect.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Dev convenience -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- In-JVM Kubernetes API server double for controller/service tests without a cluster. -->
        <dependency>
            <groupId>io.fabric8</groupId>
            <artifactId>kubernetes-server-mock</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>kweblens</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>org.alexmond.kweblens.KweblensApplication</mainClass>
                </configuration>
                <executions>
                    <!-- Generate build-info.properties so the /status page can show the version. -->
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>coverage-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <!-- The app entry point is not unit-tested by design. -->
                            <excludes>
                                <exclude>org/alexmond/kweblens/KweblensApplication.class</exclude>
                            </excludes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.50</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
