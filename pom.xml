<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>org.alexmond</groupId>
    <artifactId>kweblens-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>kweblens-parent</name>
    <description>kweblens parent POM — a web-based Kubernetes IDE (Freelens on Spring Boot)</description>
    <url>https://github.com/alexmond/kweblens</url>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/alexmond/kweblens/issues</url>
    </issueManagement>

    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Alex Mondshain</name>
            <email>alex.mondshain@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git@github.com:alexmond/kweblens.git</connection>
        <developerConnection>scm:git:git@github.com:alexmond/kweblens.git</developerConnection>
        <tag>HEAD</tag>
        <url>https://github.com/alexmond/kweblens</url>
    </scm>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>

        <!-- Browser-driven screenshot/capture tests (@Tag("ui")) are presentation tooling,
             not correctness gates: they need a real Chrome and are timing-sensitive, so
             they're excluded from the default build (and CI's `mvn verify`) to keep the gate
             reliable. Run them on demand with `-DexcludedGroups=`. -->
        <excludedGroups>ui</excludedGroups>

        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
        <maven-pmd-plugin.version>3.28.0</maven-pmd-plugin.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <spring-javaformat.version>0.0.47</spring-javaformat.version>
        <checkstyle.version>13.6.0</checkstyle.version>

        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <central-publishing-maven-plugin.version>0.11.0</central-publishing-maven-plugin.version>

        <!-- Kubernetes access: fabric8 kubernetes-client (7.x targets Java 17+ / Jackson used
             by Boot 4). The BOM aligns the whole client + model + mock-server set. -->
        <fabric8.version>7.3.1</fabric8.version>

        <!-- jhelm: the sibling Helm-in-Java library (dogfood). jhelm-kube brings jhelm-core; its
             Kubernetes client backend is pluggable/optional and kweblens drives it with fabric8
             (already on the classpath), so no io.kubernetes client is needed.
             Keep this a RELEASED version — it must resolve from Maven Central. A -SNAPSHOT here
             only ever exists in a local ~/.m2 (jhelm publishes no snapshots), so CI cannot resolve
             it and the whole build goes red. The fabric8 backend landed in 1.5.0. -->
        <jhelm.version>1.5.0</jhelm.version>
        <!-- jhelm's chart rendering needs snakeyaml-engine with CoreScalarResolver(boolean); Spring
             Boot's BOM otherwise pins 2.9 (no such ctor -> NoSuchMethodError at chart load). Boot uses
             classic org.yaml:snakeyaml, not this engine, so overriding to jhelm's version is safe. -->
        <snakeyaml-engine.version>3.0.1</snakeyaml-engine.version>

        <!-- Spring AI (MCP server) — 2.0.x line targets Spring Boot 4 / Spring Framework 7 -->
        <spring-ai.version>2.0.0</spring-ai.version>
        <!-- Boot-4.0-aligned train — for the optional config-server client. -->
        <spring-cloud.version>2025.1.2</spring-cloud.version>

        <picocli.version>4.7.7</picocli.version>

        <!-- Terminal UI (kweblens-tui). TamboUI is the widget layer; JLine is the substrate
             underneath it and supplies org.jline.builtins.ScreenTerminal, the VT emulator the
             exec pane renders a remote byte stream with. Library choice settled by the GH#361
             spike; see docs/research/k9s-functionality.md §11. -->
        <tamboui.version>0.4.0</tamboui.version>
        <jline.version>3.30.16</jline.version>

        <!-- SonarQube analysis scope. The CLI and the TUI are console apps whose stdout IS their
             output (S106); test sources aren't a quality gate. Host URL + token passed at scan time. -->
        <sonar.projectKey>kweblens</sonar.projectKey>
        <sonar.projectName>kweblens</sonar.projectName>
        <sonar.issue.ignore.multicriteria>cliStdout,tuiStdout,testSources</sonar.issue.ignore.multicriteria>
        <sonar.issue.ignore.multicriteria.cliStdout.ruleKey>java:S106</sonar.issue.ignore.multicriteria.cliStdout.ruleKey>
        <sonar.issue.ignore.multicriteria.cliStdout.resourceKey>**/kweblens-cli/**</sonar.issue.ignore.multicriteria.cliStdout.resourceKey>
        <sonar.issue.ignore.multicriteria.tuiStdout.ruleKey>java:S106</sonar.issue.ignore.multicriteria.tuiStdout.ruleKey>
        <sonar.issue.ignore.multicriteria.tuiStdout.resourceKey>**/kweblens-tui/**</sonar.issue.ignore.multicriteria.tuiStdout.resourceKey>
        <sonar.issue.ignore.multicriteria.testSources.ruleKey>*</sonar.issue.ignore.multicriteria.testSources.ruleKey>
        <sonar.issue.ignore.multicriteria.testSources.resourceKey>**/src/test/**</sonar.issue.ignore.multicriteria.testSources.resourceKey>
    </properties>

    <!--
        Only the publishable libraries live here, so `mvn -Prelease deploy` (which deactivates the
        activeByDefault 'default' profile) publishes just these to Maven Central. The runnable apps
        (kweblens-web, kweblens-tui) are applications, not libraries — they're added by the
        'default' profile below (and kweblens-web also by 'docker') and are never published.
    -->
    <modules>
        <module>kweblens-core</module>
        <module>kweblens-cli</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Internal modules -->
            <dependency>
                <groupId>org.alexmond</groupId>
                <artifactId>kweblens-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Override Spring Boot's snakeyaml-engine (2.9) with the version jhelm requires. -->
            <dependency>
                <groupId>org.snakeyaml</groupId>
                <artifactId>snakeyaml-engine</artifactId>
                <version>${snakeyaml-engine.version}</version>
            </dependency>

            <!-- fabric8 Kubernetes client BOM — aligns client, model, and mock-server. -->
            <dependency>
                <groupId>io.fabric8</groupId>
                <artifactId>kubernetes-client-bom</artifactId>
                <version>${fabric8.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring AI (MCP server) — 2.0.x line targets Spring Boot 4 / Spring Framework 7 -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud BOM — import scope only; the config-server client is the only starter pulled. -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- TamboUI BOM — aligns the widget layer with its JLine 3 backend. -->
            <dependency>
                <groupId>dev.tamboui</groupId>
                <artifactId>tamboui-bom</artifactId>
                <version>${tamboui.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--
                JLine, pinned on the UBER artifact — and that is the whole point.

                tamboui-jline3-backend:0.4.0 depends on `org.jline:jline` (the uber jar), which
                bundles org/jline/terminal/**, org/jline/reader/** and org/jline/builtins/**
                under exactly the package names the SPLIT artifacts (jline-terminal,
                jline-reader, jline-builtins) also use. So managing the split artifacts forward
                — which docs/research/k9s-functionality.md §11 originally instructed — does not
                override anything: it puts a SECOND copy of every class on the classpath beside
                the uber, and jar order decides the winner. Probed on that classpath by the
                GH#361 spike, org.jline.builtins.ScreenTerminal — the exec pane's entire VT
                emulator — still loaded from the stale 3.25.1 uber jar, silently, because
                duplicate classes are not an error.

                Managing the uber instead replaces the one artifact TamboUI actually asks for,
                so the resolved classpath carries exactly one jline jar and one copy of every
                class. dependencyManagement governs EVERY path that ever pulls the uber, so a
                future transitive (a TamboUI bump, picocli-shell-jline3) is pinned too rather
                than reintroducing the duplicate. Deliberately do NOT also manage the split
                artifacts here: naming them is what made the original instruction look correct.

                JLineSingleProviderTest asserts the outcome rather than the intent — one
                classpath URL per class, all three from the same jar — because "it works today"
                is exactly what a duplicated classpath looks like.
            -->
            <dependency>
                <groupId>org.jline</groupId>
                <artifactId>jline</artifactId>
                <version>${jline.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                            <configuration>
                                <formats>
                                    <format>XML</format>
                                    <format>HTML</format>
                                </formats>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <!-- Lombok annotation processing -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>

                <!-- Code style: Spring Java Format -->
                <plugin>
                    <groupId>io.spring.javaformat</groupId>
                    <artifactId>spring-javaformat-maven-plugin</artifactId>
                    <version>${spring-javaformat.version}</version>
                    <executions>
                        <execution>
                            <phase>validate</phase>
                            <goals>
                                <goal>validate</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- PMD -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <version>${maven-pmd-plugin.version}</version>
                    <configuration>
                        <targetJdk>${java.version}</targetJdk>
                        <linkXRef>false</linkXRef>
                        <failOnViolation>true</failOnViolation>
                        <printFailingErrors>true</printFailingErrors>
                        <includeTests>false</includeTests>
                        <rulesets>
                            <ruleset>${maven.multiModuleProjectDirectory}/pmd-ruleset.xml</ruleset>
                        </rulesets>
                    </configuration>
                    <executions>
                        <execution>
                            <id>pmd-check</id>
                            <phase>validate</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- Checkstyle (Spring checks via spring-javaformat) -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>${maven-checkstyle-plugin.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>io.spring.javaformat</groupId>
                            <artifactId>spring-javaformat-checkstyle</artifactId>
                            <version>${spring-javaformat.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>com.puppycrawl.tools</groupId>
                            <artifactId>checkstyle</artifactId>
                            <version>${checkstyle.version}</version>
                        </dependency>
                    </dependencies>
                    <executions>
                        <execution>
                            <id>checkstyle-validation</id>
                            <phase>validate</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <configLocation>${maven.multiModuleProjectDirectory}/checkstyle.xml</configLocation>
                                <suppressionsLocation>${maven.multiModuleProjectDirectory}/checkstyle-suppressions.xml</suppressionsLocation>
                                <includeTestSourceDirectory>true</includeTestSourceDirectory>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <!-- Release helpers (active under the 'release' profile) -->
                <plugin>
                    <groupId>io.github.git-commit-id</groupId>
                    <artifactId>git-commit-id-maven-plugin</artifactId>
                    <executions>
                        <execution>
                            <goals>
                                <goal>revision</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <verbose>true</verbose>
                        <dateFormat>yyyy-MM-dd'T'HH:mm:ssZ</dateFormat>
                        <generateGitPropertiesFile>true</generateGitPropertiesFile>
                        <generateGitPropertiesFilename>
                            ${project.build.outputDirectory}/git.properties
                        </generateGitPropertiesFilename>
                        <skipPoms>false</skipPoms>
                        <useNativeGit>true</useNativeGit>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>attach-sources</id>
                            <goals>
                                <goal>jar-no-fork</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <configuration>
                        <failOnError>false</failOnError>
                    </configuration>
                    <executions>
                        <execution>
                            <id>attach-javadocs</id>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>${maven-gpg-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>sign-artifacts</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>sign</goal>
                            </goals>
                            <configuration>
                                <gpgArguments>
                                    <arg>--pinentry-mode</arg>
                                    <arg>loopback</arg>
                                </gpgArguments>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>${central-publishing-maven-plugin.version}</version>
                    <extensions>true</extensions>
                    <configuration>
                        <publishingServerId>central</publishingServerId>
                        <autoPublish>true</autoPublish>
                        <!--
                            Return once Central has validated the bundle (signatures, metadata,
                            structure). autoPublish then publishes in the background. 'published'
                            blocks until full Maven Central propagation, which routinely exceeds
                            the plugin's poll timeout and fails an otherwise-successful release.
                        -->
                        <waitUntil>validated</waitUntil>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>io.spring.javaformat</groupId>
                <artifactId>spring-javaformat-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Adds the runnable app to every normal build (verify, dev, CI). Active unless another
            profile is explicitly requested — so `-Prelease` drops kweblens-web from the reactor
            (it must not reach Maven Central), while `-Pdocker` re-adds it (see below) to keep the
            image build working.
        -->
        <profile>
            <id>default</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <modules>
                <module>kweblens-ui</module>
                <module>kweblens-web</module>
                <module>kweblens-it</module>
                <!--
                    kweblens-tui is here and NOT in the top-level <modules>, i.e. it is built and
                    gated by every ordinary `verify` (and by CI) but is never published to Maven
                    Central, and `-Prelease` / `-Pdocker` drop it. That is deliberate (GH#362): it
                    is an application whose public surface is a screen, not an API anyone compiles
                    against, and the two modules that DO publish are the two that owe callers a
                    stable API. The repo has already paid for the other choice once — kweblens-cli
                    is on the publishing path and shipped a fat jar that died on its first line
                    (#363) — and seven queued tickets (#364-#370) will rewrite this module's
                    internals, which is the worst possible thing to have under a published
                    coordinate. Publishing it later is a one-line move; unpublishing is not.
                -->
                <module>kweblens-tui</module>
            </modules>
        </profile>

        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>io.github.git-commit-id</groupId>
                        <artifactId>git-commit-id-maven-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Build an OCI image with Cloud Native Buildpacks (no Dockerfile needed):
              ./mvnw -Pdocker package                          (build all modules + the web image)
              ./mvnw -Pdocker -pl kweblens-web -am package     (just the runnable module's image)
            Override the tag or publish to a registry:
              ./mvnw -Pdocker -Ddocker.image.name=ghcr.io/alexmond/kweblens:0.1.0 -Ddocker.publish=true package
            Requires a running Docker daemon. Only kweblens-web (which declares the Spring Boot
            plugin) produces an image; the config lives in pluginManagement so other modules are
            unaffected.
        -->
        <profile>
            <id>docker</id>
            <!-- Re-add the app (+ its UI): explicitly activating this profile deactivates 'default'. -->
            <modules>
                <module>kweblens-ui</module>
                <module>kweblens-web</module>
            </modules>
            <properties>
                <docker.image.name>kweblens:${project.version}</docker.image.name>
                <docker.publish>false</docker.publish>
            </properties>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-maven-plugin</artifactId>
                            <configuration>
                                <image>
                                    <name>${docker.image.name}</name>
                                    <env>
                                        <BP_JVM_VERSION>${java.version}</BP_JVM_VERSION>
                                    </env>
                                </image>
                                <publish>${docker.publish}</publish>
                            </configuration>
                            <executions>
                                <execution>
                                    <id>build-image</id>
                                    <phase>package</phase>
                                    <goals>
                                        <goal>build-image</goal>
                                    </goals>
                                </execution>
                            </executions>
                        </plugin>
                    </plugins>
                </pluginManagement>
            </build>
        </profile>
    </profiles>
</project>
